{
  "name": "bmad-visio",
  "version": "2.2.0",
  "description": "Visualize BMAD Method epics & user stories with AI-powered git commit matching",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "bmad-visio": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "build:server": "tsc",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "bmad",
    "dashboard",
    "agile",
    "user-stories",
    "kanban",
    "project-management",
    "transformers-js",
    "embeddings",
    "git",
    "commit-matching",
    "visualization",
    "BMAD METHOD",
    "AI"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/williammesi/bmad-visio"
  },
  "author": "William Mesiti",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "marked-highlight": "^2.2.3",
    "mdast-util-to-string": "^4.0.0",
    "pinia": "^3.0.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "simple-git": "^3.33.0",
    "unified": "^11.0.5",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
